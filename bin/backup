#!/bin/bash
. ~/.bashrc

## Implements the command usage, parsed from the script itself

commands() {
  grep '[a-z] *[)] *###' $0 | sed 's/ *\([a-z]\)[^#]*#* */  \1: /'
}

usage() {
  cat <<EOU
  Usage: backup [\$option ... ]
Backups user file and manages external volumes.
 - With no argument runs interactively.
Options:
EOU
  commands
}

if [ "$1" = -h -o "$1" = --help ] ; then usage ; exit ; fi
   
## Manages backup functions.

askForVolume() { # askForVolume $prompt; Asks for a volume reference.
  while true ; do
    (sudo df -a -H -T --output=source,target,used,avail | grep -E '^(/dev/sd|Filesystem)' | awk 'NR == 1 { print "   "  $0 } NR > 1 { print NR-1 ": "  $0 }' ; echo '0: Quit') | tee /tmp/$$~ ; n="`cat /tmp/$$~ | wc -l`"
    if [ "$n" -lt 3 ] ; then echo "No volume mounted, please proceed and rerun" ; exit ; fi
    read -p "Select the $1 between 1 and $((n-2)) : " -n 1 -e rep
    if [ "$rep" = 0 ] ; then exit ; fi
    if [ \( 0 -lt "$rep" \) -a \( "$rep" -lt "$((n-1))" \) ] ; then 
      volumeSource="`head /tmp/$$~ -n $((rep+1)) | tail -1 | awk '{ print $2}'`"
      volumeTarget="`head /tmp/$$~ -n $((rep+1)) | tail -1 | awk '{ print $3}'`"
      return
    fi
    sudo mount $volumeSource
  done      
}

askForDisk() { # askForDisk $prompt; Asks for a disk reference.
  while true ;do
    ((echo 'Disk device·s' ; lsblk  -n -r -o NAME,SIZE,TYPE /dev/sd* | grep disk | sed 's/^\(.*\)disk/\/dev\/\1/') | awk 'NR == 1 { print "   "  $0 } NR > 1 { print NR-1 ": "  $0 }' ; echo '0: Quit')  | tee /tmp/$$~ ; n="`cat /tmp/$$~ | wc -l`"
    if [ "$n" -lt 3 ] ; then echo "No volume mounted, please proceed and rerun" ; exit ; fi
    read -p "Select the $1 between 1 and $((n-2)) : " -n 1 -e rep
    if [ "$rep" = 0 ] ; then exit ; fi
    if [ \( 0 -lt "$rep" \) -a \( "$rep" -lt "$((n-1))" \) ] ; then 
      volumeSource="`head /tmp/$$~ -n $((rep+1)) | tail -1 | awk '{ print $2}'`"
      return
    fi
  done
}

askForSSD() { # askForSSD ; Asks for the external backup volume, if not yet defined.
  if [ -z "$SSD" ] ; then askForVolume 'external backup volume' ; SSD="$volumeTarget" ; fi
}

forSmartPhone() { # forSmartPhone $command … ; Executes a command w.r.t to smart-phone
  SmartPhone='SAMSUNG_SAMSUNG_Android_R58Y60DJ3AF'
  SmartPhoneDir="/run/user/`id -u $USER`/gvfs/mtp:host=$SmartPhone/Stockage interne"
  (pcmanfm "$SmartPhoneDir" >/dev/null 2>&1 &) ; sleep 1 # This allows to mount the device :)
  if [ -d "$SmartPhoneDir" ] ; then
    for c in $* ; do $c ; done
  else
    echo "The Smartphone file system is not connected, you must manually allow the connection."
  fi
}

rsync="rsync -a -z --archive --info=progress2"


if [ -z "$1" ]
then
  ## Implements the interactive backup menu.
  while true ; do
    echo 'What to backup:' ; commands ; echo '  q: Quit' 
    read -p "Option: " -n 1 -e rep
    if [ "$rep" = q ] ; then exit ; fi
    $0 $rep
  done
else
  while [ \! -z "$1" ] ; do case "$1" in
  ## Implements backup commands, each command with lower-case letter.

    b ) ### Backups the home directory on an external backup volume.
      askForSSD
      mkdir -p $SSD/home
      rsync  -a -z --info=progress2 --delete-excluded --exclude '.config/chromium/Singleton*' --archive "/home/$USER/" "$SSD/home/"
      ;;
    
    c ) ### Creates a volume from a disk image.
      if uname -a | grep -q rpi && [ -e /dev/mmcblk0 ] && confirm "Backup the present system SD-card ?"
      then sd_card_source='/dev/mmcblk0'
      else
	confirm "Download a disk image on the Desktop, is it done"
	if [ \! -z "`ls ~/Desktop/*.img.xy 2>/dev/null`" ]
	then needfor xz-utils ; for f in  ~/Desktop/*.img.xy ; do unxz $f ; done
	fi
	sd_card_source="`ls -t1  ~/Desktop/*.img 2>/dev/null | head -1`"
      fi
      askForDisk 'Volume to write (will be erased !)'
      if confirm "Erases and make a bootable image from $sd_card_source on $volumeSource"
      then sudo dd if="$sd_card_source" of=$volumeSource bs=4M status=progress conv=fsync
      fi
      ;;

    d ) ### Downloads a disk as a volume image.
      askForDisk 'Volume to download'
      img="~/Desktop/disk-`basename $volumeSource`-`date --iso=seconds`-$$.img"
      if confirm "Makes an image '$img' from $volumeSource"
      then
	sudo dd if=$volumeSource of="$img" bs=4M status=progress
	if [ \! -z "`which xz`" ] ; then xz -9q "$img" ; fi
      fi
      ;;
    
    f ) ### Formats a mounted volume.
      askForDisk 'Volume to format (will be erased !)'
      if confirm "Formats that volume and erase all data" "OK, bye" ; then
	sudo umount $volumeSource* 2>/dev/null
	sudo mkfs.ext4 $volumeSource
      fi
      ;;
    
    r ) ### Repairs the volume (e.g., mounted in read-only).
      echo -e '- It is often mounted in read-only mode after an abrupt disconnection.\n- If the device is blocked "busy" now:\n  - check that all application (filer, terminal) working on the volume are closed,\n  - wait a few seconds and rerun;\n  - if it persists, you may have to reboot first and then rerun this command.'
      askForSSD
      sudo umount $volumeSource 
      sudo fsck -y $volumeSource
      sudo mount $volumeSource
      ;;
    
    s ) ### Syncs all git repositories with default message.
      git_sync
      ;;
    
    u ) ### Updates and upgrades the installation, using apt.
      (sudo apt update -q -y  ; sudo apt full-upgrade -q -y ; sudo apt autoremove -q -y ; sudo apt-file update)  2>&1 | grep -E -v '(^[HGRW]|configured multiple times|^ *$)'
      ;;

    ## Implements hidden commands, using upper-case letters.

    U ) ### [Hidden] Uploads the 'vthierry' smartphone's picture, specific to this user, although it may inspire for your own usage.
      uploadsSmartphoneMedias () {
	echo 'Uploads smart-phone {DCIM|Pictures} for local use'
	bakfile ~/Desktop/medias -d
	for d in "$SmartPhoneDir/DCIM/" "$SmartPhoneDir/Pictures/"
	do if [ -d "$d" ] ; then $rsync --exclude=".thumbnails" "$d" ~/Desktop/medias ; fi
	done
	#### Proposes small size versions of the camera photos.
	if [ \! -z "`ls -A  ~/Desktop/medias/Camera/*.jpg 2>/dev/null`" ] ; then					  
	  mkdir -p ~/Desktop/medias/Camera400
	  mogrify -auto-orient -resize 400 -path ~/Desktop/medias/Camera400 ~/Desktop/medias/Camera/*.jpg
	  pcmanfm ~/Desktop/medias/Camera400 >/dev/null 2>&1 &
	fi
      }
      forSmartPhone uploadsSmartphoneMedias
      ;;
    
    V ) ### [Hidden] Backups the 'vthierry' smartphone medias, specific to this user, although it may inspire for your own usage.
      backupMediaFiles() {
	askForSSD
	echo 'Backups my-music'
	$rsync --delete-excluded "$SmartPhoneDir/my-music" "$SSD"
	echo 'Backups WhatsApp media files'
	WhatsApp="$SmartPhoneDir/Android/media/com.whatsapp/WhatsApp/Media/"
	mkdir -p  "$SSD/my-medias/WhatsApp"
	$rsync "$WhatsApp/WhatsApp Images/" "$SSD/my-medias/WhatsApp/Media/"
	$rsync "$WhatsApp/WhatsApp Audio/" "$SSD/my-medias/WhatsApp/Media/"
	$rsync "$WhatsApp/WhatsApp Video/" "$SSD/my-medias/WhatsApp/Media/"
      }
      forSmartPhone backupMediaFiles
      ;;
    esac ; shift
  done
fi
