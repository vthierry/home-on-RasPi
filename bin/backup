#!/bin/bash
. ~/.bashrc

usage() {
  cat <<EOU
  Usage: backup [\$w ... ]
Backups user file on external devices.
 - With no argument runs interactively.
Options:
 - \$w ... : One or more backup choice·s (see interactive menu).
EOU
}

## Manages backup functions.

askForDisk() { # askForDisk $diskName; Asks for a disk reference.
  while true ; do
    (sudo df -a -H --output=source,target,used,avail | grep -E '^(/dev/sd|Filesystem)' | awk 'NR == 1 { print "   "  $0 } NR > 1 { print NR-1 ": "  $0 }' ; echo '0: Quit') | tee /tmp/df$$.txt ; n="`cat /tmp/df$$.txt | wc -l`"
    if [ "$n" -lt 3 ] ; then echo "No disk mounted, please proceed and rerun" ; exit ; fi
    read -p "Select the $1 between 1 and $((n-2)) : " -n 1 -e rep
    if [ "$rep" = 0 ] ; then exit ; fi
    if [ \( 0 -lt "$rep" \) -a \( "$rep" -lt "$((n-1))" \) ] ; then 
      diskSource="`head /tmp/df$$.txt -n $((rep+1)) | tail -1 | awk '{ print $2}'`"
      diskTarget="`head /tmp/df$$.txt -n $((rep+1)) | tail -1 | awk '{ print $3}'`"
      return
    fi
  done      
}

askForSSD() { # askForSSD ; Asks for the external backup disk, if not yet defined.
  if [ -z "$SSD" ] ; then askForDisk 'external backup disk' ; SSD="$diskTarget" ; fi
}

rsync="rsync -a -z --archive --info=progress2"

## Implements the interactive backup menu.

if [ -z "$1" ]
then
  while true ; do cat <<EOF
What to backup:
 b: Backups the /home/$USER directory to the external backup disk.
 s: Syncs all git repositories with default commit message.
 i: Creates an image of the SD-card on the external backup disk.
 q: Quit
EOF
    read -p "Option: " -n 1 -e rep
    if [ "$rep" = q ] ; then exit ; fi
    $0 $rep
  done
else
  while [ \! -z "$1" ] ; do case "$1" in

    b ) ### Backups the home directory to the external backup disk.
      askForSSD
      mkdir -p $SSD/home
      rsync  -a -z --info=progress2 --delete-excluded --exclude '.config/chromium/Singleton*' --archive "/home/$USER/" "$SSD/home/"
      ;;
    
    s ) ### Syncs all git repositories with default message.
      git_sync
      ;;
    
    r ) ### [TO BE DONE] Rclone synchronize local and remote files.
      ;;
    
    c ) ### [Hidden, because to be tested] Creates a bootable spare SD-card.
      askForDisk 'Bootable SD-card (will be erased !)'
      if confirm "Erases and make a bootable image on $diskSource" "OK, bye" ; then
	sudo dd if=/dev/mmcblk0 of=$diskSource bs=4M status=progress conv=fsync
      fi
      ;;
    
    i ) ### Creates an image of the SD-card on the external backup disk.
      askForSSD
      if confirm "Creates a system image on /media/$USER/$SSD/sd-card-copy.img\n\t (this will take about half-an-hour for a 64GB card)" ; then
	sudo dd if=/dev/mmcblk0 of=$SSD/backup/sd-card-copy.img bs=1M status=progress
      fi
      ;;
    
    v ) ### [Hidden] Backups the 'vthierry' user specific smartphone, although you may get inspired to adapt to your own usage.
      SmartPhone="/run/user/`id -u $USER`/gvfs/mtp:host=SAMSUNG_SAMSUNG_Android_R58Y60DJ3AF/Stockage interne"
      ls "$SmartPhone"
      if [ "$USER" = "vthierry" ] ; then
	if [ -d "$SmartPhone" ] ; then
	  if confirm 'Uploads smart-phone {DCIM|Pictures} for local use' ; then
	    bakfile ~/Desktop/medias -d
	    for d in "$SmartPhone/DCIM/" "$SmartPhone/Pictures/"
	    do if [ -d "$d" ] ; then $rsync --exclude=".thumbnails" "$d" ~/Desktop/medias ; fi
	    done
	    #### Proposes small size versions of the camera photos.
	    if [ \! -z "`ls -A  ~/Desktop/medias/Camera/*.jpg 2>/dev/null`" ] ; then					  
	      mkdir -p ~/Desktop/medias/Camera400
	      mogrify -auto-orient -resize 400 -path ~/Desktop/medias/Camera400 ~/Desktop/medias/Camera/*.jpg
	      pcmanfm /home/vthierry/Desktop/medias/Camera400 >/dev/null 2>&1 &
	    fi
 	  fi
	  if confirm 'Backups my music' ; then
	    askForSSD
	    $rsync --delete-excluded "$SmartPhone/my-music" "$SSD"
	  fi
	  if confirm 'Backups WhatsApp media files' ; then
	    askForSSD
	    WhatsApp="$SmartPhone/Android/media/com.whatsapp/WhatsApp/Media/"
	    mkdir -p  "$SSD/my-medias/WhatsApp"
	    $rsync "$WhatsApp/WhatsApp Images/" "$SSD/my-medias/WhatsApp/Media/"
	    $rsync "$WhatsApp/WhatsApp Audio/" "$SSD/my-medias/WhatsApp/Media/"
	    $rsync "$WhatsApp/WhatsApp Video/" "$SSD/my-medias/WhatsApp/Media/"
	  fi
	else
	  echo "The Smartphone file system is not connected"
	fi
      fi
      ;;
    esac ; shift
  done
fi
