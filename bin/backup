#!/bin/bash
. ~/.bashrc

## Implements the command usage, parsed from the script itself

commands() {
  grep '[a-z] *[)] *###' $0 | sed 's/ *\([a-z]\)[^#]*#* */  \1: /'
}

usage() {
  cat <<EOU
  Usage: backup
Backups user file and manages external volumes.
Options:
EOU
  commands
}

if [ "$1" = -h -o "$1" = --help ] ; then usage ; exit ; fi
   
## Implements backup utilitaries.

chooseVolume() { # chooseVolume ; for the backup volume reference, if not yet defined.
  if [ -z "$volume" ] && choose "backup volume" "`sudo df -a -H --output=source,target,used,avail | grep -E '^(/dev/sd|Filesystem)'`" ; then
    volumeDev="`echo $choice | awk '{ print $1 }'`"
    volume="`echo $choice | awk '{ print $2}'`"
    echo "volumeDev : $volumeDev ; volume : $volume"
  fi
  if [ -z "$volume" ] ; then return 1 ; else return 0 ; fi
}
volume=""

setDisks() { # setDisk ; Sets the available disk's list, recognized by size
  if [ -z "disks" ]
  then disks="`lsblk -n -r -o NAME,SIZE,TYPE /dev/sd* | grep disk | sed 's/^\([^ ]*\) *\(.*\)disk/\/dev\/\1 of size \2/'`"
  fi
}
disks=""

forSmartPhone() { # forSmartPhone $command ; Executes a command w.r.t to a unique connected and mounted smart-phone
  gvfs_root="/run/user/`id -u $USER`/gvfs/"
  gvfs_mnt="`ls -t1 $gvfs_root 2>/dev/null | head -1`"
  SmartPhoneDir="$gvfs_root/$gvfs_mnt/`ls $gvfs_root/$gvfs_mnt/`"
  if [ -d "$SmartPhoneDir" ]
  then 
    $1
    return 0
  else
    echo "The Android Smartphone file internal storage system is not connected, you must manually allow the connection."
    return 1
  fi
}
SmartPhoneDir=""

### Synchronization command
rsync="rsync -a -z --archive --info=progress2"

backup() { # backup $c ; Implements the backup interactive commands.
  case "$1" in

    b ) ### Backups the home directory on an external backup volume.
      if chooseVolume ; then 
	mkdir -p $volume/home
	$rsync --delete-excluded --exclude '.config/chromium/Singleton*' --archive "/home/$USER/" "$volume/home/"
      fi
      ;;
    
    c ) ### Creates a volume or a disk image from such a source.
      #### Considers the system SD-card on a Raspberry-Pi.
      if uname -a | grep -q rpi && [ -e /dev/mmcblk0 ] ; then disk0="/dev/mmcblk0 the present system SD-card" ; fi
      #### Considers volume image files
      if confirm "To proceed, if needed:\n-Consider the ./etc/*.img[.xz] backup disk files\n-Download a disk image there or on the Desktop\nWaiting for the confirmation ... OK"
      then
	if chooseVolume ; then imgs="$volume/etc/*.{img,img.xy}" ; fi
	imgs="`ls -t1 $imgs ~/Desktop/*.{img,img.xy} 2>/dev/null`"
      fi
      ### Considers available disks
      setDisks
      if choose 'source' "Sources:\n$imgs\n$disks\n$disk0" ; then source="`echo $choice | awk '{ print $1 }'`" ; fi
      img="`date --iso=seconds`-$$-`echo $source | sed s'/\/dev/\//'`.img"
      if choose 'target' "Targets:\n~/Desktop/$img\n$volume/etc/$img\n$disks" ; then target="`echo $choice | awk '{ print $1 }'`" ; fi
      if [ \! -z "$source" -a \! -z "$target" ]
      then
	if [ \! -z "`echo $source | grep -q '\.xz$'`" ] ; then needfor xz-utils ; unxz "$source" ; source="`echo $source | sed 's/.xz$//'`" ; fi
	if confirm "Erase all data on $target and mirror $source in it"
	then sudo dd if="$source" of="$target" bs=4M status=progress conv=fsync
	fi
	if [ \! -z "`echo $target | grep -q '\.img$'`" -a \! -z "`which xz`" ] ; then xz -9q "$target" ; fi
      fi
      ;;
    
    f ) ### Formats a volume.
      setDisks
      if choose 'volume to erase and format' "`echo -e 'Available disk·s\n$disks'`" && confirm "Erases all data and formats this volume, really" ; then
	volumeDev="`echo $choice | awk '{ print $1 }'`"
	sudo umount $volumeDev* 2>/dev/null
	sudo mkfs.ext4 $volumeDev
      fi
      ;;
    
    r ) ### Repairs the volume (e.g., mounted in read-only).
      echo -e '- It is often mounted in read-only mode after an abrupt disconnection.\n- If the device is blocked "busy" now:\n  - check that all application (filer, terminal) working on the volume are closed,\n  - wait a few seconds and rerun;\n  - if it persists, you may have to reboot first and then rerun this command.'
      if chooseVolume ; then 
	sudo umount $volumeDev
	sudo fsck -y $volumeDev
      fi
      ;;
    
    s ) ### Syncs all git repositories with default message.
      git_sync
      ;;
    
    u ) ### Updates and upgrades the installation, using apt.
      (sudo apt update -q -y  ; sudo apt full-upgrade -q -y ; sudo apt autoremove -q -y ; sudo apt-file update)  2>&1 | grep -E -v '(^[HGRW]|configured multiple times|^ *$)'
      ;;

    ## Implements hidden commands, using upper-case letters.

    U ) ### [Hidden] Uploads the 'vthierry' smartphone's picture, specific to this user, although it may inspire for your own usage.
      uploadsSmartphoneMedias () {
	echo 'Uploads smart-phone {DCIM|Pictures} for local use'
	bakfile ~/Desktop/medias -d
	for d in "$SmartPhoneDir/DCIM/" "$SmartPhoneDir/Pictures/"
	do if [ -d "$d" ] ; then $rsync --exclude=".thumbnails" "$d" ~/Desktop/medias ; fi
	done
	#### Proposes small size versions of the camera photos.
	if [ \! -z "`ls -A  ~/Desktop/medias/Camera/*.jpg 2>/dev/null`" ] ; then					  
	  mkdir -p ~/Desktop/medias/Camera400
	  mogrify -auto-orient -resize 400 -path ~/Desktop/medias/Camera400 ~/Desktop/medias/Camera/*.jpg
	  pcmanfm ~/Desktop/medias/Camera400 >/dev/null 2>&1 &
	fi
      }
      forSmartPhone uploadsSmartphoneMedias
      ;;
    
    V ) ### [Hidden] Backups the 'vthierry' smartphone medias, specific to this user, although it may inspire for your own usage.
      backupMediaFiles() {
	echo 'Backups WhatsApp media files'
	WhatsApp="$SmartPhoneDir/Android/media/com.whatsapp/WhatsApp/Media/"
	mkdir -p  "$volume/my-medias/WhatsApp"
	$rsync "$WhatsApp/WhatsApp Images/" "$volume/my-medias/WhatsApp/Media/"
	$rsync "$WhatsApp/WhatsApp Audio/" "$volume/my-medias/WhatsApp/Media/"
	$rsync "$WhatsApp/WhatsApp Video/" "$volume/my-medias/WhatsApp/Media/"
	echo 'Backups my-music'
	$rsync --delete-excluded "$SmartPhoneDir/my-music" "$volume"
      }
      if chooseVolume ; then forSmartPhone backupMediaFiles ; fi
      ;;
  esac
}


## Implements the interactive backup menu.
while true ; do
  echo 'Menu:' ; commands ; echo '  q: Quit' 
  read -p "Option: " -n 1 -e rep
  if [ "$rep" = q ] ; then exit ; fi
  backup $rep
done
