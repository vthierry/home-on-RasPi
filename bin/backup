#!/bin/bash
. ~/.bashrc

# Usage: backup ; Backups the whole system and the user home dir, after inserting the external disk.

## Detects the external disk

for d in "`ls -1 /media/$USER`" ; do
  if confirm "Is '$d' the backup disk" ; then SSD="$d" ; break ; fi
done
if [ -z "$SSD" ] ; then echo "Upps: no backup disk, bye." ; exit ; fi

#=> sudo df -a -H --output=source,fstype,size,used,avail,pcent,target | grep -E '^(/dev|Filesystem)'

## Performs the backup
	   
mkdir -p /media/$USER/$SSD/backup

if confirm "Mirrors your home directory in the backup directory"
then rsync  -a -z --info=progress2 --delete-excluded --exclude '.config/chromium/Singleton*' --archive "/home/$USER/" "/media/$USER/$SSD/backup/"
fi

if confirm "Syncs git repositories"
then cd ~ ; git_sync
fi     
   
#if confirm "Syncs rlcone repositories"
#then cd ~ ;
#fi     

# Avec la détection automatique d'une carte SD
#if confirm "Creates a spare SD-card ?"
#then
#fi   

if confirm "Creates an image of the SD-card on $SSD in the backup directory"
then
    echo "This will take about half-an-hour for a 64GB card"
    sudo dd if=/dev/mmcblk0 of=/media/$USER/$SSD/backup/sd-card-copy.img bs=1M status=progress
fi   

## The reminder is specific to the user `vthierry` smartphone, although you may get inspired and adapt to your usage

if [ "$USER" = "vthierry" ]
then   
    SmartPhone="/run/user/1000/gvfs/mtp:host=SAMSUNG_SAMSUNG_Android_R58Y60DJ3AF/Stockage interne"
    if [ -d "$SmartPhone" ] ; then
      if confirm "Opens the smartphone data in filer" ; then pcmanfm "$SmartPhone" ; fi 
      if confirm "Uploads smart-phone pictures for local use" ; then
        mkdir -p ~/Desktop/medias
        for d in "$SmartPhone/DCIM/" "$SmartPhone/Pictures/" ; do if [ -d "$d" ] ; then
    	  rsync -a -z --info=progress2 --archive "$d" ~/Desktop/medias/
	fi ; done
      fi
      if confirm "Backups WhatsApp media   files" ; then
        WhatsApp="$SmartPhone/Android/media/com.whatsapp/WhatsApp/Media/"
	rsync -a -z --archive --info=progress2 "$WhatsApp/WhatsApp Images/" "/media/$USER/$SSD/backup/my-medias/WhatsApp/Media/"
	rsync -a -z --archive --info=progress2 "$WhatsApp/WhatsApp Audio/" "/media/$USER/$SSD/backup/my-medias/WhatsApp/Media/"
	rsync -a -z --archive --info=progress2 "$WhatsApp/WhatsApp Video/" "/media/$USER/$SSD/backup/my-medias/WhatsApp/Media/"
      fi
    fi
fi



