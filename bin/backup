#!/bin/bash
. ~/.bashrc

# Usage: backup ; Backups the whole system and the user home dir, after inserting the external disk.

## Detects the external disk

for d in "`ls -1 /media/$USER`" ; do
  if confirm "Is '$d' the backup disk" ; then SSD="$d" ; break ; fi
done
if [ -z "$SSD" ] ; then echo "Upps: no backup disk, bye." ; exit ; fi

## Performs the backup
	   
mkdir -p /media/$USER/$SSD/backup

echo "Creates an image of the SD-card on $SSD in the backup directory"
sudo dd if=/dev/mmcblk0 of=/media/$USER/$SSD/backup/sd-card-copy.img bs=1M status=progress

echo "Mirrors your home directory in the backup directory"
rsync  -a -z --archive "/home/$USER" "/media/$USER/$SSD/backup"

## The reminder is specific to the user `vthierry`, although you may get inspired and adapt

if [ "$USER" = "vthierry" ]
then   

  echo "Syncs git repositories."
  bin/git_sync

  echo "Syncs smartphone data"
  SmartPhone="/run/user/1000/gvfs/mtp:host=SAMSUNG_SAMSUNG_Android_R58Y60DJ3AF/Stockage interne"
  if [ -d "$SmartPhone" ] ; then
      echo "Uploads DCIM images for local use"
      mkdir -p ~/Desktop/medias
      for data in "$SmartPhone/DCIM" "$SmartPhone/Pictures" ; do if [ -d "$d" ] ; then 
	rsync -a -z --info=progress2 --archive "$d" ~/Desktop/medias
      fi ; done					       
      echo "Backups Media files"
      mkdir -p /media/$USER/$SmartPhone/backup/medias
      WhatsApp="$SmartPhone/Stockage interne/Android/media/com.whatsapp/WhatsApp/Media/"
      for data in "my-music" "$WhatsApp/WhatsApp Images" "$WhatsApp/WhatsApp Video" ; do
        rsync -a -z --archive "$data" "/media/$USER/$SmartPhone/backup/medias"
      done
  fi
fi



