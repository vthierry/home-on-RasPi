#!/bin/bash

## Script usage

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: update
- Installs or updates the home directory to work as a tiny workstation.
  - This is "your" personal update script allowing to maintain a reproducible configuration.
  - You have to READ it and ADAPT it BEFORE running it (though nothing catastrophic happens, if not).
  - The .bashrc 'update' function performs the proper 'apt update' without reviewing the whole configuration.
    - It prevents from unwanted run of this 'bin/update' script.
  - Use: \`dpkg-query -W -f='${Installed-Size;8}  ${Package}\n' | sort -n\` to have installed package in  size order, allowing to purge (wirth care !) unused.
EOU
exit
fi

## Cleans unused or temporary home directories and files to lighten the configuration.
/bin/rm -rf ~/{README.md,.git,.gitignore,.profile,.xsession-errors*,.Xauthority,.emacs.d}
sudo /bin/rm -rf .cache

## Creates the user main directories.
mkdir -p etc sketchbook

## Links the Documents and Downloads to the Desktop to have all working files at the same place.
mv ~/{Documents,Downloads,Music,Pictures,Public,Templates,Videos}/* ~/Desktop  2>/dev/null
rmdir ~/{Documents,Downloads,Music,Pictures,Public,Templates,Videos} 2>/dev/null

## Removes unused packages (in order to save place, and clean the menu, for easier use).
sudo apt purge -qq -y firefox                 # Chromium has better performance on the RasPi.
sudo apt purge -qq -y rpi-connect # No need a priori to remotely control this Raspi, while it is possible via SSH.
sudo apt purge -qq -y squeekboard             # No need to have a virtual keyboard on the screen.
sudo apt purge -qq -y geany                   # A programmer's IDE, not very useful when using makefiles (see below).
sudo apt purge -qq -y thonny                  # A Python IDE for beginners only useful for .. Python beginners, https://editor.raspberrypi.org is a very nice alternative.
sudo apt purge -qq -y evince                  # A document viewer redundant with the browser.
sudo apt purge -qq -y piclone rpi-imager      # Using a better tool to backup/restore the SD-card.
sudo apt purge -qq -y rp-bookshelf yelp       # No need to browse the Raspberry Pi Press  in this context.
sudo apt purge -qq -y rp-prefapps pi-package  # Better not choose to install applications from a menu, but in this file, for reproducibility.
sudo apt purge -qq -y realvnc-vnc-server         # No use of VNC in this context.
sudo apt purge -qq -y libvncclient1 libneatvnc0 wayvnc # In link with VNC.
sudo apt purge -qq -y  rpd-wallpaper-trixie  # Not used for a sober environment.
sudo apt purge -qq -y  scrot                      # A screenshot not used … and not worlking ;(.
sudo apt autopurge -qq -y

## Adds useful system packages.
sudo apt update -qq -y
sudo apt install -qq -y git                    # Git is preinstalled (thus a simple reminder here).
sudo apt install -qq -y nodejs                 # JavaScript is used for Web interaction and many useful tools.
#sudo apt install -qq -y rclone                 # Rclone is used for file interaction with on-line cloud systems.
sudo apt install -qq -y speedtest-cli          # Very useful to test the internet speed test.
sudo apt install -qq -y wlrctl		# Used to automatized GUI actions.
#
## Adds useful multimedia packages.
sudo apt install -qq -y pdftk                  # Every day PDF file manipulation.
sudo apt install -qq -y gimp                   # A reference for image editing.
sudo apt install -qq -y audacity               # The reference for audio editing.
sudo apt install -qq -y shotcut                # A good solution for video editing.
sudo apt install -qq -y ffmpeg                 # Everyday video/audio file manipulation (needed by Shotcut).
sudo apt install -qq -y yt-dlp                 # A tool for video downloading
sudo apt install -qq -y simple-scan            # A suitable image scanner.
sudo apt install -qq -y wf-recorder            # A … simple powerful screen recorder.
#sudo apt install -qq -y screenruler   # Measures pixel lengths on screen (heavy installation because based on KDE).
#sudo apt install -qq -y kruler   # Measures pixel lengths on screen (heavy installation because based on ruby).
#sudo apt install -qq -y color-picker # Measures a color everywhere in the screen
#
## Adds office packages, if not working online.
### Note: The key point is that there is no need to install the whole LibreOffice productivity software, if only partially used.
#sudo apt install -qq -y libreoffice-writer     # The reference textual document editor.
#sudo apt install -qq -y libreoffice-calc       # The spreadsheet document editor.
#sudo apt install -qq -y libreoffice-draw       # The reference drawing editor.
#sudo apt install -qq -y libreoffice-impress    # The reference slide presentation editor.
#sudo apt install -qq -y libreoffice-impress    # The reference slide presentation editor.
#sudo apt install -qq -y inkscape                  # The reference vectorial graphics SVG editor.

## Adds useful development packages, in the https://github.com/vthierry/idnai context.
#sudo apt install -qq -y emacs                  # The best universal computer editor of the … XXe century :), choose your one.
#sudo apt install -qq -y arduino                # The toolchain for developing on the ESP32 processor as well.
#sudo apt install -qq -y kicad                  # The tool to develop printed circuit boards.
#sudo apt purge -qq -y kicad-demos        # The tool to develop printed circuit boards.

## Finalizes package updates
sudo apt update -qq -y ; sudo apt full-upgrade -qq -y; sudo apt autoremove -qq -y

## Cleans not useful application's loaders
sudo /bin/rm -f /usr/share/applications/{emacsclient,emacsclient-mail,emacs-mail,emacs-term,org.kicad.{bitmap2component,eeschema,gerbview,pcbcalculator,pcbnew}}.desktop

## Adapts the author username to your username, after download
for f in grep -lr vthierry .local/share/{applications,file-manager} .config/{GIMP,labwc,lxterminal,libfm,menus,pcmanfm,rpcc,wf-panel-pi}
do subst vthierry $USER $f $f
done

## Considers ~/.local/share/applications/default.list as the mime associations root file and updates ~/{.config,.local/share/applications}/mimeapps.list accordingly
cp ~/.local/share/applications/default.list ~/.local/share/applications/mimeapps.list
cp ~/.local/share/applications/default.list ~/.config/mimeapps.list

## Asks for reboot
read -p "Shall we reboot ? (y/n): " -n 1 -e rep ; if [ "$rep" = y ] ; then sudo reboot ; fi
