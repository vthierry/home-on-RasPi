#!/bin/bash

# Usage: git_sync $message ; Synchronizes with the current repository adding a commit message.

if [ -z "$*" ] ; then m="minor modification" ; else m="$*" ; fi

"`dirname $0`"/clean

sync() {
    git pull -q --allow-unrelated-histories
    if [ \! -z "`git status -s`" ] ; then git commit -q -a -m "$1" ; git push -q ; fi
    git status -s
}

sync $m

for g in `find -name .git` ; do d="`dirname $g`" ; if [ "$d" \!= "." ] ; then
   if confirm "Shall we sync $g" ; then
       pushd $d > /dev/null ; sync $m ; popd > /dev/null
fi ; fi ; done


