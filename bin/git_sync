#!/bin/bash

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: git_sync [\$commit_message]
Synchronizes the Git remote repository with the current one.
- The local repository is pulled, commited and pushed, in order to synchronize.
- Paths with difference with respect to this commit are listed.
- Sub-directories containing other git repositories are also synchronized too.
EOU
exit
fi

## Default commit message
if [ -z "$*" ] ; then m="minor modification" ; else m="$*" ; fi

## Checks for the id_rsa key
if [ -f ~/bin/id_rsa_add ] ; then ~/bin/id_rsa_add  ; fi

git_sync_here() { # Usage: git_sync_there $root-directory ; Implements the synchronization of git repository from its root directory.
  pushd "$1" > /dev/null
  echo "Sync `basename $(pwd)` repository:" 
  git pull -q --allow-unrelated-histories
  if [ \! -z "`git status -s`" ] ; then git commit -q -a -m "$m" ; git push -q ; fi
  git status -s
  popd > /dev/null 
}

get_git_root() { # Usage: get_git_root $directory ; Gets the git root directory of the current location.
  if [ -d "$1/.git" ] ; then echo "$1" ; elif [ "$1" \!= "/" ] ; then get_git_root "`dirname \"$1\"`" ; fi
}


## Synchronize the current repository
git_sync_here "`get_git_root \"$(pwd)\"`"
## … and any sub-repository
gits="`find . -type d -a -regex '.*/\.git'`"
for g in $gits ; do if [ "$g" \!= "./.git" ] ; then git_sync_here "`dirname $g`" ; fi ; done


