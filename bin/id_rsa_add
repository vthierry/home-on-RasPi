#!/bin/bash
. ~/.bashrc

# Internal usage : id_rsa_add ; Manages ssh-add ~/.ssh/id_rsa at login or if something when wrong with the ssh-agent

if [ -z "$SSH_AGENT_PID" ]
then
  echo 'No accessible ssh-agent: your better logout and login again.'
  exit 1
fi

if ! ssh-add -L 2>/dev/null | grep "^`cat ~/.ssh/id_rsa.pub`$" > /dev/null
then
  echo 'The ~/.ssh/id_rsa is not added: asking for it.'
  
  ## Ask for the ssh-add key in a console
 console -g 64x1 ssh-add -q ~/.ssh/id_rsa 

  ## Checks that it has been properly added
  if ssh-add -L 2>/dev/null | grep "^`cat ~/.ssh/id_rsa.pub`$" > /dev/null ; then exit 0 ; else echo 'Adding ~/.ssh/id_rsa failed.' ; exit 1 ; fi
fi




