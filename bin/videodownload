#!/bin/bash
. ~/.bashrc
## Installs the package via atp if not yet done
needfor yt-dlp
## Enforces a recent release from https://github.com/yt-dlp/yt-dlp/releases
echo "Video-downloading starting …"
sudo yt-dlp --update > /dev/null

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: videodownload [\$url]
- Downloads a video.
- If the \$url is not given, runs in interactive mode. 
EOU
exit
fi

if [ -z "$1" ] ; then read -p "URL ? " url ; else url="$*" ; fi

yt-dlp --js-runtimes node:/usr/bin/node $url 2>&1 | grep '^\[download\]'

