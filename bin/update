#!/bin/bash

# Usage: update ; Installs or updates the home directory to work as a tiny workstation.
##
## - This is only a prototypical command list:
##                     READ it and ADAPT it BEFORE running it
##     (unless nothing is catastrophic if you do not)
##
## Note: The .bashrc update function prevents from unwanted run of this bin/update script.

## Cleans unused or temporary home directories and files to lighten the configuration.

rmdir ~/{Documents,Downloads,Music,Pictures,Public,Templates,Videos} 2>/dev/null
/bin/rm -rf ~/{README.md,.git,.gitignore,.profile,.xsession-errors*,.Xauthority,.emacs.d}
sudo /bin/rm -rf .cache
### Links the Documents and Downloads to the Desktop to have all working files at the same place
for d in Documents Downloads ; do ln -s ~/Desktop ~/$d ; done

## Removes unused packages (in order to save place, and clean the menu, for easier use).

sudo apt remove -qq -y firefox                 # Chromium has better performances on the RasPi.
sudo apt remove -qq -y rpi-connect             # No need a priori to remote control this Raspi, while it is possible via ssh.
sudo apt remove -qq -y squeekboard             # No need to have a virtual keyboard on the screen.
sudo apt remove -qq -y geany                   # A programmer's IDE, not very useful when using makefiles (see below).
sudo apt remove -qq -y thonny                  # A Python IDE for beginners only useful for .. Python beginners.
sudo apt remove -qq -y piclone rpi-imager      # Using a better tool to backup/restore the SD-card.
sudo apt remove -qq -y rp-bookshelf yelp       # No need to browse the Raspberry Pi Press  in this context.
sudo apt remove -qq -y rp-prefapps pi-package  # Better not choose to install applications from a menu, but in this file, for reproductibility.
sudo apt remove -qq -y realvnc-vnc-server         # No use of VNC in this context.
sudo apt remove -qq -y libvncclient1 libneatvnc0 wayvnc
#sudo apt remove -qq -y mousepad               # Do NOT suppress it unless you have chosen your favorite editor.
sudo apt autoremove -qq -y

## Adds useful system packages.
sudo apt update -qq -y
sudo apt install -qq -y git                    # Git is preinstalled (thus a simple reminder here).
sudo apt install -qq -y nodejs                 # Javascript is used for Web interaction and many useful tools.
sudo apt install -qq -y rclone                 # Rclone is used for file interaction with on-line cloud systems.
## Adds useful multimedia packages.
sudo apt install -qq -y pdftk                  # Every day PDF file manipulation.
sudo apt install -qq -y gimp                   # A reference for image edition.
sudo apt install -qq -y audacity               # The reference for audio edition.
sudo apt install -qq -y shotcut                # A good solution for video edition.
sudo apt install -qq -y ffmpeg                 # Every day video/audio file manipulation (needed ny shotcut).
sudo apt install -qq -y yt-dlp                 # A tool for video downloading
sudo apt install -qq -y simple-scan            # A suitable image scanner.
sudo apt install -qq -y kazam                # A … simple poweful screen recorder.
## Adds useful development packages, in the https://github.com/vthierry/idnai context.
sudo apt install -qq -y emacs                  # The best universal computer editor of the … XXe century :), choose your one.
sudo apt install -qq -y arduino                # The tool to develop akso on the ESP32 processor.
sudo apt install -qq -y kicad                  # The tool to develop printed circuit board.

## Finalizes package's update
sudo apt update -qq -y  ; sudo apt full-upgrade -qq -y ; sudo apt autoremove -qq -y

## Cleans and enriches application's loaders
sudo /bin/rm -f /usr/share/applications/{emacsclient,emacsclient-mail,emacs-mail,emacs-term,org.kicad.{bitmap2component,eeschema,gerbview,pcbcalculator,pcbnew}}.desktop

## Enrichs the PCManFM actions
mkdir -p ~/.local/share/file-manager/actions
cp ~/.config/etc/file-manager-actions/*.desktop ~/.local/share/file-manager/actions

## Asks for reboot
read -p "Shall we reboot ? (y/n): " -n 1 -e rep ; if [ "$rep" = y ] ; then sudo reboot ; fi
