#!/bin/bash
. ~/.bashrc

# Internal usage: wraps Ctrl+F* to applications:
## - On the Menu => System => Control Center => Hardware => Keyboard Shortcuts => Custom Shortcuts ...
## - Ctrl+F* are mapped on ./bin/shortcut F* to have a ease the definition of global desktop shortcuts.
## - Undefined shortcuts are mapped on the shortcut's usage panel display.

## Defines commands with a suitable name, since it is grepped to show the shortcut's usage.

backup() {
  console backup
}
scan() {
  simple-scan
}
vpn () {
  /opt/cisco/secureclient/bin/vpnui
}
maple() {
  console -g 120x80-1-1 /local/data/linux-install/maple2026/bin/maple
}

## Implements the Ctrl+F1 to Ctrl+F12 shortcuts, if any
if [ -z "$1" ] ; then
  ### Automatic usage, grepping the script case items.
  echo "Available shortcuts (Ctrl+F*):"
  grep '.* ).*;;' < $0 | grep -v grep | sed 's/_* *&.*//'
else
  case "$1" in
    F1 ) thunderbird &;;
    F2 ) screenshot &;;
    F3 ) gimp &;;
    F4 ) scan &;;
    F5 ) backup &;;
    F6 ) vpn &;;
    F7 ) maple &;;
    #### We need to write '*)' and not '* )'for the automatic usage greeping.
    *) lxterminal --profile=xterm --geometry=32x10+10+32 -e "bash -c '$0 ; read cont'" ;;
  esac
fi
