#!/bin/bash
. ~/.bashrc

## Starts the ssh agent if not yet done
if [ -z "`ps -ef | grep ssh-agent | grep -v grep`" ]
then /usr/bin/ssh-agent | grep '^SSH_' > .ssh/SSH_ENV ; chmod 600  .ssh/SSH_ENV ; . .ssh/SSH_ENV
fi

## Starts the ssh agent if not yet done
if ! ssh-add -L 2>/dev/null | grep "^`cat ~/.ssh/id_rsa.pub`$" > /dev/null
then console -g 32x2 ssh-add .ssh/id_rsa
fi

## Checks that it has been properly added
if ssh-add -L | grep "^`cat ~/.ssh/id_rsa.pub`$" > /dev/null ; then exit 0 ; else exit 1 ; fi








