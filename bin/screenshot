#!/bin/bash

if [ "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: screenshot
Starts the gimp's screenhot window.
EOU
exit
fi

gimp -b '(plug-in-screenshot 0 2 0 0 0 0 0)'

if [ \! -z "`which xdotool`" ]
then xdotool search --sync --onlyvisible --name 'GNU Image Manipulation Program' windowminimize
fi
if [ \! -z "`which wlctrl`" ]
then while \! wlrctl window minimize gimp ; do sleep 1 ; done
fi
