#!/bin/bash
. ~/.bashrc
needfor pdftk

if [ -z "$1" -o "$1" = -h -o "$1" = --help ]
then cat <<EOU
Usage: pdfcompress \$input_pdf_file \$output_pdf_file
- Compresses a pdf file.
EOU
exit
fi

bakfile $2
if [ "$1" = "$2" ] ; then i="$1~" ; else i="$1" ; fi   
pdftk "$i" output "$2" compress

## Note: Alternative is gs -dBATCH -dNOPAUSE -q -sDEVICE=pdfwrite -sOutputFile="compressed_$1" "$1"
