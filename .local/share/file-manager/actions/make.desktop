[Desktop Entry]
Type=Action
Name=Make
Icon=mate-desktop
Profiles=default;

[X-Action-Profile default]
Exec=lxterminal --profile=xterm --geometry=64x16 --title="Make" --command="bash -c '~/bin/make ; echo ... done ; read cont'"
Name=Default profile
MimeTypes=inode/directory;
Comment=Makes the default target
